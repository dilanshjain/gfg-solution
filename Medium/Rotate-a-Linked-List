
class Solution {
    public Node rotate(Node head, int k) {
        if (head == null || head.next == null || k == 0)
            return head;

        Node temp = head;
        int len = 1;

        while (temp.next != null) {
            temp = temp.next;
            len++;
        }

        k = k % len;

        if (k == 0)
            return head;

        temp = head;

        for (int i = 1; i < k; i++) {
            temp = temp.next;
        }

        Node newHead = temp.next;
        temp.next = null;

        Node tail = newHead;

        while (tail.next != null) {
            tail = tail.next;
        }

        tail.next = head;

        return newHead;
    }
}
